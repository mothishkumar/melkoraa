# Map from Next.js .env.local (names only — never commit filled values).
# Required for catalog, auth, cart, checkout:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Auth email redirects (map from NEXT_PUBLIC_SITE_URL in Next, or use SPA origin):
SITE_URL=http://localhost:5173

# Optional — required only to reach Razorpay payment boundary:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Express runtime (not in Next .env.local):
PORT=4318
API_PUBLIC_URL=http://localhost:4318
CORS_ORIGIN=http://localhost:5173
ADMIN_CORS_ORIGIN=http://localhost:5174
NODE_ENV=development
