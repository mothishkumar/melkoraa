# Copy from repo root .env / .env.local — server secrets never go to the SPA.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Frontend origin (Vite dev server or production SPA URL) — used for auth email redirects
SITE_URL=http://localhost:5173

# Razorpay (server only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PORT=4318
API_PUBLIC_URL=http://localhost:4318
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
