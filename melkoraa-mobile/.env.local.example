# Local overrides — copy to `.env.local` (gitignored).
# Expo loads `.env.local` after `.env` and overrides matching keys.
# Use this file for machine-specific LAN API URLs during physical device QA.

EXPO_PUBLIC_APP_ENV=development

# Replace <LAN-IP> with your computer's Wi-Fi/Ethernet address (not localhost).
# Example shape only — do not commit your real IP:
# EXPO_PUBLIC_API_URL=http://<LAN-IP>:4317/api/v1

# Supabase public keys (same as web NEXT_PUBLIC_* values) if not already in `.env`
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
