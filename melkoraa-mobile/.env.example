# App environment: development | production
EXPO_PUBLIC_APP_ENV=development

# MELKORAA REST API
# Production default: https://www.melkoraa.in/api/v1
EXPO_PUBLIC_API_URL=https://www.melkoraa.in/api/v1

# Optional local API override for development (never use private IPs in production builds)
# localhost works in simulators only — physical devices need your computer's LAN IP:
# EXPO_PUBLIC_DEV_API_URL=http://192.168.x.x:4317/api/v1
#
# Full authenticated mobile testing requires the melkoraa_mobile API (Bearer auth).
# Production www.melkoraa.in may 401 on protected routes until main deploys 7467fb4.

# Supabase public keys — required for mobile auth (same project as web NEXT_PUBLIC_* values)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL used for marketing links (auth emails use melkoraa:// deep links)
EXPO_PUBLIC_SITE_URL=https://www.melkoraa.in

# Optional — set when creating an EAS project
# EAS_PROJECT_ID=
