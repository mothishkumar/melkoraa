# App environment: development | production
EXPO_PUBLIC_APP_ENV=development

# MELKORAA REST API
# Production default: https://www.melkoraa.in/api/v1
EXPO_PUBLIC_API_URL=https://www.melkoraa.in/api/v1

# Physical device QA: copy .env.local.example → .env.local and set:
#   EXPO_PUBLIC_API_URL=http://<LAN-IP>:4317/api/v1
# (.env.local overrides .env and is gitignored — do not commit your LAN IP)
#
# localhost works in simulators only — phones resolve localhost to themselves.
# Full authenticated testing requires local melkoraa_mobile API (Bearer auth).
# See PHYSICAL_DEVICE_QA.md and: npm run verify:local-api

# Supabase public keys — required for mobile auth (same project as web NEXT_PUBLIC_* values)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL used for marketing links (auth emails use melkoraa:// deep links)
EXPO_PUBLIC_SITE_URL=https://www.melkoraa.in

# Optional — set when creating an EAS project
# EAS_PROJECT_ID=
