# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:4317

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Runtime / serverless: Supabase Transaction Pooler URI (port 6543).
# Required in development, production, and tests that hit the database.
# The app singleton (src/db/index.ts) reads only this variable. postgres.js uses prepare:false.
# Startup logs hostname category, port, database name, and pool max — never the URI or password.
DATABASE_URL=

# Migrations / Drizzle Kit only: direct/session Postgres URI (port 5432).
# Required for npm run db:migrate / db:generate / db:studio. Never used by request handlers.
DIRECT_DATABASE_URL=

# Optional runtime pool size per Node isolate (1–8). Tests default to 1. Production default is 4.
# POSTGRES_POOL_MAX=4

NODE_ENV=development

# Razorpay (server only — never NEXT_PUBLIC_)
# Required in production when taking payments. Optional in local catalog-only work.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
