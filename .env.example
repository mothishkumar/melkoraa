# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Runtime / serverless: Supabase transaction pooler URI (port 6543)
DATABASE_URL=

# Migrations / Drizzle Kit: direct Postgres URI (port 5432)
DIRECT_DATABASE_URL=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:4317
NODE_ENV=development

# Razorpay (server only — never NEXT_PUBLIC_)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
